{
  "name": "ocr-studio-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:ocr-studio-ui": "node dist/ocr-studio-ui/server/server.mjs",
    "generate:api": "del-cli --force ./src/app/core/api/ src/app/core/api/model && openapi-generator-cli generate -i ./src/assets/openapi.json -g typescript-angular -o ./src/app/core/modules/openapi --additional-properties fileNaming=kebab-case --generate-alias-as-model"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.1",
    "@angular/common": "^19.2.1",
    "@angular/compiler": "^19.2.1",
    "@angular/core": "^19.2.1",
    "@angular/forms": "^19.2.1",
    "@angular/platform-browser": "^19.2.1",
    "@angular/platform-browser-dynamic": "^19.2.1",
    "@angular/platform-server": "^19.2.1",
    "@angular/router": "^19.2.1",
    "@angular/ssr": "^19.2.1",
    "chart.js": "^4.4.8",
    "express": "^4.21.2",
    "primeicons": "7.0.0",
    "primeng": "19.0.9",
    "primeflex": "^4.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.1",
    "@angular/cli": "^19.2.1",
    "@angular/compiler-cli": "^19.2.1",
    "@openapitools/openapi-generator-cli": "2.17.0",
    "@types/express": "^5.0.0",
    "@types/jasmine": "~5.1.7",
    "@types/node": "^22.13.9",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
